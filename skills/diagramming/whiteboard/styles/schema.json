{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/devbyshima/skills/styles/schema.json",
  "title": "whiteboard preset",
  "type": "object",
  "required": ["name", "version", "palette", "roles", "shapes", "font", "edges"],
  "additionalProperties": false,
  "properties": {
    "$schema":    { "type": "string" },
    "name":       { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "version":    { "type": "integer", "const": 1 },
    "default":    { "type": "boolean" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type":         { "type": "string", "enum": ["excalidraw", "image", "built-in", "hand-authored"] },
        "path":         { "type": "string" },
        "extracted_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "success", "warning", "accent", "danger", "neutral", "secondary"],
      "properties": {
        "primary":   { "$ref": "#/$defs/colorPair" },
        "success":   { "$ref": "#/$defs/colorPair" },
        "warning":   { "$ref": "#/$defs/colorPair" },
        "accent":    { "$ref": "#/$defs/colorPair" },
        "danger":    { "$ref": "#/$defs/colorPair" },
        "neutral":   { "$ref": "#/$defs/colorPair" },
        "secondary": { "$ref": "#/$defs/colorPair" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service":  { "$ref": "#/$defs/slotName" },
        "database": { "$ref": "#/$defs/slotName" },
        "queue":    { "$ref": "#/$defs/slotName" },
        "gateway":  { "$ref": "#/$defs/slotName" },
        "error":    { "$ref": "#/$defs/slotName" },
        "external": { "$ref": "#/$defs/slotName" },
        "security": { "$ref": "#/$defs/slotName" }
      }
    },
    "shapes": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
      "properties": {
        "service":   { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
        "database":  { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
        "queue":     { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
        "decision":  { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
        "external":  { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] },
        "container": { "type": "string", "enum": ["rectangle", "ellipse", "diamond"] }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size"],
      "properties": {
        "family":    { "type": "string", "enum": ["hand", "normal", "code"] },
        "size":      { "type": "integer", "minimum": 8, "maximum": 48 },
        "titleSize": { "type": "integer", "minimum": 8, "maximum": 64 }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strokeStyle", "endArrowhead"],
      "properties": {
        "strokeStyle":    { "type": "string", "enum": ["solid", "dashed", "dotted"] },
        "startArrowhead": { "type": ["string", "null"], "enum": [null, "arrow", "triangle", "dot", "bar", "diamond"] },
        "endArrowhead":   { "type": ["string", "null"], "enum": [null, "arrow", "triangle", "dot", "bar", "diamond"] },
        "dashedFor":      { "type": "array", "items": { "type": "string" } }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roughness":   { "type": "integer", "enum": [0, 1, 2] },
        "fillStyle":   { "type": "string", "enum": ["solid", "hachure", "cross-hatch"] },
        "strokeWidth": { "type": "number", "enum": [1, 2, 4] }
      }
    }
  },
  "$defs": {
    "colorPair": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strokeColor", "backgroundColor"],
          "properties": {
            "strokeColor":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "backgroundColor": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|transparent)$" }
          }
        }
      ]
    },
    "slotName": {
      "type": "string",
      "enum": ["primary", "success", "warning", "accent", "danger", "neutral", "secondary"]
    }
  }
}
